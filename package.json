{
	"name": "obsidian-fold-by-bullet",
	"version": "0.3.1",
	"description": "Obsidian plugin that folds list items by default based on their bullet character.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"fold",
		"outline",
		"markdown"
	],
	"author": "Akira Hirata",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.10.2",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "^6.28.0",
		"@types/node": "^20.14.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.5",
		"obsidian": "latest",
		"tslib": "^2.6.3",
		"typescript": "^5.5.2"
	}
}
